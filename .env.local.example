# Wren's Junk Removal — environment variables
# Copy this file to `.env.local` and fill in real values.
# In production, set these in the Vercel dashboard (Project → Settings → Environment Variables).

# --- Lead email (Resend) ---
# 1. Sign up free at https://resend.com
# 2. Create an API key and paste it here.
# 3. Verify your domain (e.g. wrensjunkremoval.com) to send from a branded address.
RESEND_API_KEY=

# Where quote requests are emailed (Chase's Gmail to start).
LEAD_EMAIL=cpwern1@gmail.com

# The "from" address. Use Resend's test sender until your domain is verified.
LEAD_FROM=Wren's Quotes <onboarding@resend.dev>

# --- Photo uploads (Vercel Blob) ---
# Auto-added when you create a Blob store in the Vercel dashboard (Storage → Blob).
# For local testing, run `vercel env pull` after linking the project.
BLOB_READ_WRITE_TOKEN=
